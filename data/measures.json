  "versions": [
    {
      "name": "WP",
      "displayName": "Working Plan",
      "description": "Current working plan version"
    },
    {
      "name": "LY",
      "displayName": "Last Year",
      "description": "Same period last year actuals"
    },
    {
      "name": "LLY",
      "displayName": "Last Last Year",
      "description": "Same period two years ago actuals"
    },
    {
      "name": "OP",
      "displayName": "Original Plan",
      "description": "Original plan version"
    },
    {
      "name": "CP",
      "displayName": "Current Plan",

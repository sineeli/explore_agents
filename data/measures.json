    {
      "name": "RCPT_RTL",
      "displayName": "Receipt $",
      "aliases": ["receipt dollars", "receipts $"],
      "dataType": "DOUBLE",
      "description": "Receipt value in retail dollars"
    },
    {
      "name": "AUR",
      "displayName": "Average Unit Retail",

    },
    {
      "name": "ACT",
      "displayName": "Actuals",
      "description": "Actual reported values"
    },
    {
      "name": "BUPP",
      "displayName": "Bottom-Up Plan Proposed",
      "description": "Bottom-up plan proposed version"
    },
    {
      "name": "BULP",
      "displayName": "Bottom-Up Last Plan",
      "description": "Bottom-up last plan version"
    },
    {
      "name": "PRODFC",
      "displayName": "Product Forecast",
      "description": "Product forecast version"
    },
    {
      "name": "TW",
      "displayName": "This Week",
      "description": "Current week actual value"
    },
    {
      "name": "LW",
      "displayName": "Last Week",
      "description": "Previous week actual value"
    }
  ],
  "derivedVersions": [
    {
      "name": "BUPP_BULP_VP",
      "displayName": "BUPP/BULP % Variance",
      "description": "Percentage variance between Bottom-Up Plan Proposed (BUPP) and Bottom-Up Last Plan (BULP). Formula: ((BUPP - BULP) / BULP) * 100",
      "baseVersion": "BUPP",
      "compareVersion": "BULP",
      "type": "percentage_variance"
    },
    {
      "name": "WP_LY_VP",
      "displayName": "WP/LY % Variance",
      "description": "Percentage variance between Working Plan and Last Year. Formula: ((WP - LY) / LY) * 100",
      "baseVersion": "WP",
      "compareVersion": "LY",
      "type": "percentage_variance"
    },
    {
      "name": "WP_LY_VD",
      "displayName": "WP/LY $ Variance",
      "description": "Dollar variance between Working Plan and Last Year. Formula: WP - LY",
      "baseVersion": "WP",
      "compareVersion": "LY",
      "type": "absolute_variance"
    },
    {
      "name": "ACT_LY_VP",
      "displayName": "ACT/LY % Variance",
      "description": "Percentage variance between Actuals and Last Year",
      "baseVersion": "ACT",
      "compareVersion": "LY",
      "type": "percentage_variance"
    },
    {
      "name": "BUPP_LY_VP",
      "displayName": "BUPP/LY % Variance",
      "description": "Percentage variance between Bottom-Up Plan Proposed and Last Year",
      "baseVersion": "BUPP",
      "compareVersion": "LY",
      "type": "percentage_variance"
    }
  ],
  "combinedMeasureVersions": {
    "description": "Each measure can be combined with any version or derived version. For example: NS_RTL + WP = 'Net Sales $ Working Plan', GM_PCT + BUPP_BULP_VP = 'Gross Margin % BUPP/BULP % Variance'. The API key for a combined measure-version is: {measure_name}{version_name} (e.g. NS_RTLWP, GM_PCTBUPP_BULP_VP)",
    "examples": [
      { "key": "NS_RTLWP",           "meaning": "Net Sales $ for Working Plan version" },
      { "key": "NS_RTLLY",           "meaning": "Net Sales $ for Last Year version" },
      { "key": "NS_RTLLLY",          "meaning": "Net Sales $ for Last Last Year version" },
      { "key": "GM_PCTBUPP",         "meaning": "Gross Margin % for BUPP version" },
      { "key": "GM_PCTBUPP_BULP_VP", "meaning": "Gross Margin % BUPP/BULP % Variance" },
      { "key": "NS_UNITSWP",         "meaning": "Net Sales Units for Working Plan version" },
      { "key": "NS_RTLPRODFC",       "meaning": "Net Sales $ for Product Forecast version" }
    ]
  }

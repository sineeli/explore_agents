      "aliases": ["gross margin percentage", "margin %", "gm %", "gm percentage", "margin percentage"],
      "dataType": "DOUBLE",
      "description": "Gross Margin as a percentage of net sales"
    },
    {
      "name": "SELL_THRU_PCT",
      "displayName": "Sell Through %",
      "aliases": ["sell through", "sell-through", "sellthrough", "sell thru"],
      "dataType": "DOUBLE",
      "description": "Sell-through rate as a percentage"
    },
    {
      "name": "INV_UNITS",
      "displayName": "Inventory Units",
      "aliases": ["inventory", "stock units", "inv units", "on hand units"],
      "dataType": "DOUBLE",

      "dataType": "DOUBLE",
      "description": "Net Sales in retail dollars"
    },
    {
      "name": "NS_UNITS",
      "displayName": "Net Sales Units",
      "aliases": ["sales units", "units sold", "unit sales"],
      "dataType": "DOUBLE",
      "description": "Net Sales in units"
    },
    {
      "name": "GM_RTL",
      "displayName": "Gross Margin $",
      "aliases": ["gross margin", "gross margin dollars", "margin $", "gm dollars", "gross margin profit"],
      "dataType": "DOUBLE",
      "description": "Gross Margin in retail dollars"
    },
    {
      "name": "GM_PCT",
